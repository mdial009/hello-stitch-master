{
  "manifest_version": 3,
  "name": "Hello Stitch",
  "version": "0.17",
  "description": "A bookmarks manager with customizable title and themes",
  "permissions": [
    "bookmarks",
    "history"
  ],
  "host_permissions": [
    "https://fonts.googleapis.com/*",
    "https://fonts.gstatic.com/*"
  ],
  "optional_host_permissions": [
    "https://www.google.com/*"
  ],
  "icons": {
    "16": "icons/web/icons8-stitch-color-16.png",
    "48": "icons/web/icons8-stitch-color-48.png",
    "144": "icons/web/icons8-stitch-color-144.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/web/icons8-stitch-color-16.png",
      "48": "icons/web/icons8-stitch-color-48.png",
      "144": "icons/web/icons8-stitch-color-144.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
