{
  "manifest_version": 2,
  "name": "Hello Stitch",
  "version": "0.16",
  "description": "A bookmarks manager with customizable title and themes",
  "permissions": [
    "bookmarks",
    "history"
  ],
  "icons": {
    "16": "icons/web/icons8-stitch-color-16.png",
    "48": "icons/web/icons8-stitch-color-48.png",
    "144": "icons/web/icons8-stitch-color-144.png"
  },
  "browser_action": {
    "default_icon": {
      "16": "icons/web/icons8-stitch-color-16.png",
      "48": "icons/web/icons8-stitch-color-48.png",
      "144": "icons/web/icons8-stitch-color-144.png"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ext@xyz.stitch.hello-friend",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_security_policy": "script-src 'self' 'wasm-unsafe-eval' 'sha256-sB2YVxvEwwnlb2Z51X3Hsuj7GKY58AupFhFmkzbASRk='; object-src 'self'"
}